{
  "expo": {
    "name": "DelivEasy",
    "slug": "delivereasy",
    "scheme": "delivereasy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0E1116"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.delivereasy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1116"
      },
      "package": "com.delivereasy.app",
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#FF7A33"
        }
      ],
      "expo-status-bar"
    ]
  }
}