# Copy this to .env.test and fill in a SEPARATE Supabase project used only
# for running the test suite. Never point this at your production database —
# tests truncate all app tables after every run.

DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-TEST-PASSWORD]@[YOUR-TEST-SUPABASE-HOST]:5432/postgres

SUPABASE_URL=https://[YOUR-TEST-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET_KEY=test-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

ALLOWED_ORIGINS=http://localhost:3000

ENV=test